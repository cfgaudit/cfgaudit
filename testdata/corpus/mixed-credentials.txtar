Pattern: a placeholder behind a vendor prefix next to a value shaped like a real token.
Issues: #1368
-- .mcp.json --
{
  "mcpServers": {
    "one": {
      "command": "npx",
      "args": ["-y", "@example/one-mcp@1.0.0"],
      "env": { "GITHUB_TOKEN": "ghp_your_token_here" }
    },
    "two": {
      "url": "https://mcp.example.invalid/sse",
      "headers": { "Authorization": "Bearer sk-ant-abcdef1234567890" }
    }
  }
}
