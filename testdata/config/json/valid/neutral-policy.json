{
  "policy": {
    "agents": [
      "claude-code",
      "devin",
      "zed",
      "continue",
      "goose",
      "kimi-cli",
      "cline",
      "cursor-cli",
      "qwen-code",
      "grok",
      "opencode",
      "kilo-code",
      "codex",
      "roo-code",
      "gemini-cli",
      "pi"
    ],
    "deny": {
      "commands": [
        "git push"
      ],
      "fetch": [
        "*.example.com",
        "example.org"
      ],
      "mcp-tools": [
        "github:delete_*",
        "linear:*"
      ],
      "read": [
        "**/.env",
        "~/.ssh/**"
      ],
      "write": [
        "src/generated/**"
      ]
    },
    "forbid-allow": {
      "commands": [
        "curl"
      ],
      "mcp-tools": [
        "github:create_issue"
      ]
    }
  }
}
